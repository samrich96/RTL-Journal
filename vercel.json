{
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(facebookexternalhit|Facebot|Twitterbot|LinkedInBot|Slackbot|Discordbot|WhatsApp|TelegramBot|SkypeUriPreview|Slack-ImgProxy|Googlebot|bingbot|Applebot|Embedly|Quora Link Preview|Pinterestbot|Redditbot|vkShare|W3C_Validator|Iframely|preview|crawler|spider|bot).*"
        }
      ],
      "destination": "/api/og?path=/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
